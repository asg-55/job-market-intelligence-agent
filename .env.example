# Required by HH API. Use a real contact address.
HH_USER_AGENT=JobMarketIntelligenceAgent/0.1 (you@example.com)
# Application access token from https://dev.hh.ru/admin
HH_ACCESS_TOKEN=

# Public remote-jobs source. Results are cached for six hours to respect its rate limits.
REMOTIVE_ENABLED=true
REMOTIVE_CACHE_HOURS=6

# Optional Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random secret used to verify Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL of the dashboard, used for the Telegram Web App button.
PUBLIC_APP_URL=

# Shared secret for local n8n -> Job Copilot API calls.
AUTOMATION_API_TOKEN=

# Optional OpenAI-compatible evaluator. Empty model keeps deterministic-only scoring.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
LLM_WEIGHT=0.6
LLM_TIMEOUT=90

DATABASE_PATH=data/job_copilot.db
PROFILE_PATH=config/profile.json
MIN_NOTIFICATION_SCORE=65
